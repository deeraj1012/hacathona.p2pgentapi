                "type": [
                  "string",
                  "null"
                ]
              },
              "missing_fields": {
                "type": "array"
              },
              "can_auto_proceed": {
                "type": "boolean"
              }
            },
            "required": [
              "cart_id",
              "buyer_id",
              "lines",
              "grand_total",
              "missing_fields",
              "can_auto_proceed"
            ],
            "additionalProperties": false
          }
