    {
      "id": "req_response_builder",
      "type": "agent",
      "name": "response_builder",
      "description": "Builds buyer-friendly response confirming requisition status",
      "position": {
        "x": 2190.875796178344,
        "y": 231.7044585987261
      },
      "deletable": true,
      "selected": false,
      "dragging": false,
      "data": {},
      "properties": {
        "retryOnFailure": false,
        "maxRetries": 3,
        "retryInterval": 2000,
        "errorHandling": "none"
      },
      "config": {
        "agentStrategy": "react",
        "model": {
          "code": "gpt-5-mini",
          "name": "OpenAI GPT-5 mini",
          "vendor": "openai",
          "provider": "azureopenai"
        },
        "promptTemplate": [
          {
            "id": "req-resp-sys-001",
            "role": "system",
            "text": "You are the Response Builder for GEP's P2P Requisition Agent. Write a clear, buyer-friendly response about the requisition status.\n\nFor ReqApproved:\n- Confirm requisition was created and approved\n- Show req_id for reference\n- Show a markdown table: Item | Qty | Unit Price | Line Total\n- Show grand total\n- Show cost centre and GL account attached\n- Show delivery address and need-by date\n- Confirm what happens next: Purchase Order will now be created automatically\n\nFor ReqPendingApproval:\n- Confirm req was submitted successfully\n- Show req_id\n- Explain it is awaiting manual approval\n- Tell them they will be notified when approved\n\nFor ReqFailed:\n- Explain clearly what went wrong in plain language\n- Suggest corrective action\n- Never say 'error' — say 'could not be created' or 'something went wrong'\n\nFormat in clean markdown. Keep under 250 words."
          },
          {
            "id": "req-resp-usr-001",
            "role": "user",
            "text": "Build the buyer response from:\n\nDomain Event: {{system.reqDomainEvent}}\nValidation Report: {{system.reqValidationReport}}\nExecution Results: {{system.reqExecutionResults}}\n\nWrite the response."
          }
        ],
